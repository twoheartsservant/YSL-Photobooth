# Local kiosk Flask process: keeps camera, printing, capture and image processing local.
PORT=5000

# Render cloud gallery service URL, e.g. https://ysl-photobooth-cloud.onrender.com
CLOUD_API_URL=
# Must match the CLOUD_SYNC_SECRET configured in Render.
CLOUD_SYNC_SECRET=
# Public base URL of the Render service, no trailing slash.
CLOUD_PUBLIC_URL=

# Set only in the Render service environment. Never commit actual credentials.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=ysl-photobooth
CLOUD_MAX_UPLOAD_BYTES=188743680
GUEST_RATE_LIMIT_PER_MINUTE=90
